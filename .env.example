# Application
APP_NAME=Prairie Signal
ENVIRONMENT=development
PIPELINE_VERSION=phase1-v1
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=/api/v1

# A unique User-Agent is required for live National Weather Service calls.
# Set NWS_CONTACT to a real public website or monitored email before live use.
# Leaving it blank keeps live NWS access explicitly disabled.
NWS_USER_AGENT=PrairieSignal/0.1
NWS_CONTACT=
NWS_BASE_URL=https://api.weather.gov

# Lincoln-centered initial service region
REGION_CONFIG_PATH=configs/regions/lincoln-512km.yaml
REGION_CENTER_LATITUDE=40.8136
REGION_CENTER_LONGITUDE=-96.7026
REGION_WIDTH_KM=512
REGION_HEIGHT_KM=512
REGION_RADIUS_KM=256
MRMS_SOURCE_CONFIG_PATH=configs/sources/mrms.yaml

# Persistence and caching
POSTGRES_DB=prairie_signal
POSTGRES_USER=prairie_signal
POSTGRES_PASSWORD=development-only-change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://prairie_signal:development-only-change-me@db:5432/prairie_signal
VALKEY_PORT=6379
CACHE_URL=redis://cache:6379/0
DATA_DIRECTORY=data
ARCHIVE_DIRECTORY=data/raw
# Docker Compose overrides these repository-relative development paths with
# container paths. The optional Census maintenance command populates them.
CENSUS_PLACES_PATH=data/raw/location-index/places.tsv
CENSUS_ZCTA_PATH=data/raw/location-index/zcta.tsv

# Product freshness thresholds (minutes)
OBSERVATION_FRESH_MINUTES=30
OBSERVATION_DELAYED_MINUTES=90
FORECAST_FRESH_MINUTES=360
FORECAST_DELAYED_MINUTES=720
ALERTS_FRESH_MINUTES=2
ALERTS_DELAYED_MINUTES=10

# Optional local observability profile
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=development-only-change-me
